{
  "name": "galaxy-fds-signer",
  "version": "0.1.0",
  "description": "Galaxy-V2 request signer and pre-signed URI generator for Xiaomi Galaxy FDS, for Node.js, Cloudflare Workers, Vercel Edge and other Web-standard runtimes.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "keywords": [
    "xiaomi",
    "galaxy",
    "fds",
    "object-storage",
    "signer",
    "signature",
    "presigned-url",
    "cloudflare-workers",
    "vercel-edge",
    "edge"
  ],
  "author": "chengww",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengww5217/galaxy-fds-signer.git"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "miniflare": "4.20260730.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.4"
  }
}

{
  "name": "galaxy-fds-signer",
  "version": "0.1.0",
  "description": "Galaxy-V2 request signer and pre-signed URI generator for Xiaomi Galaxy FDS, for Node.js, Cloudflare Workers, Vercel Edge and other Web-standard runtimes.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --project unit",
    "test:integration": "npm run build && vitest run --project integration",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json",
    "lint": "eslint . && prettier --check .",
    "fix": "eslint . --fix && prettier --write .",
    "docs": "node scripts/generate-docs.mjs",
    "release": "node scripts/release.mjs",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run smoke:pack",
    "prepublishOnly": "npm run verify"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "tabWidth": 2
  },
  "keywords": [
    "xiaomi",
    "galaxy",
    "fds",
    "object-storage",
    "signer",
    "signature",
    "presigned-url",
    "cloudflare-workers",
    "vercel-edge",
    "edge"
  ],
  "author": "chengww",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengww5217/galaxy-fds-signer.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@edge-runtime/vm": "5.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "miniflare": "5.20261006.2-beta",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
